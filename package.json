{
    "name":  "spirit-events-uganda",
    "version":  "1.0.0",
    "description":  "Spirit Events Uganda - event equipment hire and production in Kampala.",
    "private":  true,
    "type":  "commonjs",
    "scripts":  {
                    "build:css":  "tailwindcss -i ./src/input.css -o ./public/css/main.css --minify",
                    "watch:css":  "tailwindcss -i ./src/input.css -o ./public/css/main.css --watch",
                    "images":  "node scripts/optimize-images.js",
                    "build":  "npm run images \u0026\u0026 npm run build:css",
                    "dev":  "npm run watch:css",
                    "serve":  "npx --yes serve . -l 3000",
                    "verify":  "node scripts/verify.js",
                    "shoot":  "node scripts/shoot.js",
                    "shoot:slides":  "node scripts/shoot-slides.js",
                    "check":  "npm run verify \u0026\u0026 npm run shoot"
                },
    "keywords":  [
                     "events",
                     "equipment-hire",
                     "tailwindcss",
                     "uganda"
                 ],
    "license":  "UNLICENSED",
    "devDependencies":  {
                            "puppeteer":  "^25.13.0",
                            "sharp":  "^0.35.5",
                            "tailwindcss":  "^3.4.17"
                        },
    "dependencies":  {
                         "lucide-static":  "^1.54.0"
                     }
}
